{
  "info": {
    "name": "PC4 · Grupo 3 · API Denuncias (Random Forest distribuido)",
    "description": "Ejecutar en orden. Requiere el stack levantado con scripts/01_levantar.ps1. Cada consulta valida el código HTTP y el requisito de < 100 ms.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Flujo principal",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Responde en menos de 100 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(100); });",
                  "const j = pm.response.json();",
                  "pm.test(\"3 nodos ML conectados\", function () { pm.expect(j.nodesConnected).to.eql(3); });",
                  "pm.test(\"MongoDB y Redis conectados\", function () { pm.expect(j.storage.mongo).to.eql(\"conectado\"); pm.expect(j.storage.redis).to.eql(\"conectado\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Entrenar (Random Forest distribuido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/train",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "train"
              ]
            },
            "description": "Tarda 1-3 s: cada nodo carga el CSV y entrena sus árboles en paralelo. No aplica el límite de 100 ms (no es una consulta de predicción).",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"3 nodos y 32 árboles\", function () { pm.expect(j.nodeCount).to.eql(3); pm.expect(j.totalTrees).to.eql(32); });",
                  "pm.test(\"Supera la línea base en 2026\", function () { pm.expect(j.evaluation.accuracy).to.be.above(j.evaluation.baselineAccuracy); });",
                  "console.log(\"Exactitud\", j.evaluation.accuracy, \"línea base\", j.evaluation.baselineAccuracy);"
                ]
              }
            }
          ]
        },
        {
          "name": "Distritos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/districts",
              "host": [
                "{{baseUrl}}"
              ],
