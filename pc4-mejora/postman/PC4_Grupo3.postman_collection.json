                  "pm.test(\"Responde en menos de 100 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(100); });",
                  "const j = pm.response.json();",
                  "pm.test(\"10 distritos con 4 franjas\", function () { pm.expect(j.rows.length).to.eql(10); pm.expect(j.rows[0].franjas.length).to.eql(4); });"
                ]
