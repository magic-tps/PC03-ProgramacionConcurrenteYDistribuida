                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Responde en menos de 100 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(100); });",
                  "pm.test(\"50 distritos\", function () { pm.expect(pm.response.json().count).to.eql(50); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Predecir (consulta al clúster)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/predict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "predict"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"district\": \"SAN JUAN DE LURIGANCHO\",\n  \"franja\": 2,\n  \"mes\": 10,\n  \"anio\": 2026\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Responde en menos de 100 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(100); });",
                  "const j = pm.response.json();",
                  "pm.test(\"6 probabilidades que suman 1\", function () { pm.expect(j.probabilities.length).to.eql(6); const s = j.probabilities.reduce((a, c) => a + c.probability, 0); pm.expect(s).to.be.closeTo(1, 0.001); });",
                  "pm.test(\"Votan los 32 árboles\", function () { pm.expect(j.treesUsed).to.eql(32); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Predecir (misma consulta: sale de Redis)",
